prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: tcontract_capi
Description: TAPP (Tensor Algebra Processing Primitives) C ABI over the tcontract kernels
URL: https://github.com/tensor4all/tcontract-rs
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -ltcontract_capi
# Only the static archive needs these: it bundles the Rust standard library. The
# cdylib carries its own DT_NEEDED entries and a consumer needs none of this.
Libs.private: -lpthread -ldl -lm
